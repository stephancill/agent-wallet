{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-wallet",
  "main": "service/worker.ts",
  "compatibility_date": "2026-09-25",
  "vars": {
    "RESCUE_MODE": "production"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-wallet",
      "database_id": "e03cf792-ad88-4407-8552-77b80dffdefc"
    }
  ],
  "routes": [
    {
      "pattern": "agent-wallet.stupidtech.net",
      "custom_domain": true
    }
  ]
}
